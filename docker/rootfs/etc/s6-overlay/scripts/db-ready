#!/command/with-contenv sh
# s6 counts a longrun as up once its process has started; migrations need it accepting connections.
set -eu
. /etc/factorial/database.sh
if factorial_external_database; then
  read -r host port < "$factorial_database_address_file"
else
  host="$(factorial_own_database_host)"
  port=5432
fi
tries=0
until /usr/lib/postgresql/17/bin/pg_isready -q -h "$host" -p "$port"; do
  tries=$((tries + 1))
  if [ "$tries" -ge 60 ]; then
    echo "factorial: postgres at $host:$port did not accept connections within 60 seconds" >&2
    exit 1
  fi
  sleep 1
done
