#!/command/with-contenv sh
. /etc/factorial/env.sh
cd /app
# uvicorn reads FORWARDED_ALLOW_IPS from its environment alone, so the value in the settings file
# is passed on here; one in the environment (an ECS task's) wins. Unset, uvicorn trusts
# X-Forwarded-For from 127.0.0.1 only, and behind a proxy on the Docker network every client
# shares the proxy's address.
if [ -z "${FORWARDED_ALLOW_IPS:-}" ]; then
  FORWARDED_ALLOW_IPS="$(python -I -c '
import sys
from dotenv import dotenv_values
print((dotenv_values(sys.argv[1]).get("FORWARDED_ALLOW_IPS") or "").strip())
' /app/.env)"
  if [ -n "$FORWARDED_ALLOW_IPS" ]; then
    export FORWARDED_ALLOW_IPS
  fi
fi
# Longer than the load balancer's 60 s idle timeout, so the balancer, not uvicorn, closes an idle
# connection: a request it sends down one uvicorn has just closed is a 502.
exec /command/s6-setuidgid factorial uvicorn orchestrator.api.serve:app --host 0.0.0.0 --port 8000 \
  --timeout-keep-alive 75
