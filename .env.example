# Copy to .env and fill in. .env is gitignored.
#
# Two sections, read by two different things:
#
#   1. Substrate credentials, unprefixed — read directly by the runtime adapters
#      (runtime/src/runtime/adapters/) and by scripts/smoke/.
#   2. The factorial orchestrator (orchestrator/) —
#      reads FACTORIAL_-prefixed vars, via orchestrator.settings (pydantic-settings,
#      env_prefix="FACTORIAL_", nested settings joined with "__", e.g. FACTORIAL_GITLAB__TOKEN).
#      An SF_-prefixed setting is REFUSED at startup rather than ignored: it would
#      otherwise fall back to a default, and database_url's default is a local
#      development database (issue #138).
#
# The single-container image (tech-stack decision 52) reads this file as a MOUNTED FILE. Never
# pass it with `docker run --env-file`: every agent run inherits the worker's environment, and
# the master key must not reach one. The image sets the claude_cli and codex_cli LOCAL_ROOTs
# itself, and the database URL and a CORS origin added to yours when it runs its own
# Postgres (docker/rootfs/etc/factorial/env.sh).

# ============================================================================
# 1. Substrate credentials (unprefixed)
# ============================================================================

# Claude harness auth, for the smoke scripts. NOT how a fleet
# run authenticates: a run reads its key from its Runtime (decision 36), or from the
# project's secrets when its process names no runtime.
ANTHROPIC_API_KEY=sk-ant-...

# Codex auth (tech-stack decision 34). NOT how a run authenticates: the adapter reads this
# key from the run's Runtime (or the project's secrets when its process names no runtime) and
# refuses to spawn without it there, exported or not.
# Two things read it here — scripts/smoke/codex-cli-smoke.py, which drives the adapter with no
# orchestrator and so no store, and `codex-battery.sh secret`, whose whole job is PUTting it
# into one.
OPENAI_API_KEY=sk-proj-...

# ============================================================================
# 2. factorial orchestrator (orchestrator/) — FACTORIAL_ vars, orchestrator.settings.Settings
# ============================================================================
# Read by orchestrator.settings only. Every value below is the shipped code default
# unless marked REQUIRED.

# --- database ---------------------------------------------------------------
# Already has a working default for the compose Postgres reached from the host.
# The single container sets its own (docker/rootfs/etc/factorial/env.sh) — nothing to set
# here for local dev either way. On ECS the task's URL names RDS, whose host is not loopback,
# and the image then starts no Postgres of its own.
FACTORIAL_DATABASE_URL=postgresql+asyncpg://factory:factory@localhost:5432/factory

# --- api ----------------------------------------------------------------------
# Shared-secret dashboard/API auth (tech-stack decision 12). It is every org's operator bearer
# and signs the session cookies, so generate it: `openssl rand -base64 32`. Rotate by changing
# it. Sent as `Authorization: Bearer <token>`. An unset token makes the API refuse every /api
# route with a 503 (api/auth.py), and the image refuses to start with one that is empty, shorter
# than 32 characters or a sample value.
FACTORIAL_API_TOKEN=
# Browser origins allowed to call the API and open a terminal. Default is empty — the API is
# a machine interface until someone deliberately points a browser at it. Comma-separated, or
# a JSON list. Only needed for `make dev`, whose dashboard is http://localhost:5173/factorial/;
# the image sets its own (docs/local-container.md).
FACTORIAL_CORS_ORIGINS=http://localhost:5173
# Accept plain-http step preview URLs (docs/process-yaml.md, `preview`). Local
# development only: a deployment frames previews beside an https dashboard.
FACTORIAL_PREVIEW_ALLOW_HTTP=false
# uvicorn's own name, with no FACTORIAL_ prefix: the proxy addresses the API takes a client's
# address from, in X-Forwarded-For. The image passes this file's value to uvicorn, and one in
# the environment wins (the ECS task sets the VPC's CIDR). Unset, only 127.0.0.1: behind any
# other proxy every client is the proxy's address, so one client spends everyone's password
# tries and locks them out. A proxy on a Docker network: that network, such as 172.16.0.0/12.
# Never `*`, which lets a client name its own address. A request whose X-Forwarded-For the API
# ignored logs a warning once.
# FORWARDED_ALLOW_IPS=
# FastAPI's /docs, /redoc and /openapi.json. `make api` turns them on; the image exports false,
# because the load balancer forwards every path under /factorial to the internet.
FACTORIAL_API_DOCS=false
# The built dashboard the API serves under /factorial. The image sets it; under `make dev` Vite
# serves the dashboard instead.
# FACTORIAL_DASHBOARD_DIR=ui/dist

# --- secrets encryption --------------------------------------------------------
# REQUIRED, genuinely empty by default: master key (base64, 32 bytes) wrapping
# per-project data keys (tech-stack decision 8). The orchestrator cannot store a
# project secret without it — generate and set it before Step 3 of
# docs/bootstrap.md:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
FACTORIAL_MASTER_KEY=
FACTORIAL_MASTER_KEY_ID=local-dev-1

# --- github ----------------------------------------------------------------
# No GitHub setting here: each project holds its own connection (an App or a token), set on
# its Ticket source page and stored encrypted in the `secret` table. Its webhook goes to
# /factorial/webhooks/github/apps/<app_id> (App) or /factorial/webhooks/github/projects/<id>
# (token), a wake-up only (tech-stack decision 13). Never put a GitHub key or token in this file.


# --- gitlab (optional, second ticket source) --------------------------------
# Leave empty to keep a GitHub-only deployment. A project with
# ticket_source.kind=gitlab uses these.
# FACTORIAL_GITLAB__BASE_URL=https://gitlab.example.com
# FACTORIAL_GITLAB__TOKEN=
# FACTORIAL_GITLAB__WEBHOOK_SECRET=
# FACTORIAL_GITLAB__CA_BUNDLE=                 # extra CA PEMs (any private PKI), path on this host
# FACTORIAL_GITLAB__BOT_LOGIN=

# --- auth -----------------------------------------------------------------
# SSO for the dashboard. All unset (the default) leaves the password sign-in alone, which every
# deployment has — local dev needs none of these. Nobody signs in with FACTORIAL_API_TOKEN.
# The redirect URI every IdP must have registered is exactly
# <FACTORIAL_AUTH__EXTERNAL_URL>/factorial/auth/callback.
FACTORIAL_AUTH__GOOGLE_CLIENT_ID=
FACTORIAL_AUTH__GOOGLE_CLIENT_SECRET=
# Generic OpenID Connect (Entra, Auth0, Keycloak, another Google client). Issuer is enough
# for discovery; set the three URLs when the token host differs from the browser host.
# FACTORIAL_AUTH__OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# FACTORIAL_AUTH__OIDC_CLIENT_ID=
# FACTORIAL_AUTH__OIDC_CLIENT_SECRET=
# FACTORIAL_AUTH__OIDC_AUTHORIZE_URL=
# FACTORIAL_AUTH__OIDC_TOKEN_URL=
# FACTORIAL_AUTH__OIDC_USERINFO_URL=
# FACTORIAL_AUTH__OIDC_SCOPES=openid email profile
# FACTORIAL_AUTH__OIDC_LABEL=SSO
# Okta. Host only. Browser authorize uses OKTA_DOMAIN; the API uses OKTA_TOKEN_DOMAIN when
# the tenant's token host differs from its browser host.
# Redirect URI registered on the Okta web app: <FACTORIAL_AUTH__EXTERNAL_URL>/factorial/auth/callback.
# PKCE S256 is always sent. SSL_CERT_FILE / REQUESTS_CA_BUNDLE is honoured for a private IdP's CA.
# FACTORIAL_AUTH__OKTA_DOMAIN=okta.example.com
# FACTORIAL_AUTH__OKTA_TOKEN_DOMAIN=okta-token.example.com
# FACTORIAL_AUTH__OKTA_CLIENT_ID=
# FACTORIAL_AUTH__OKTA_CLIENT_SECRET=
# FACTORIAL_AUTH__OKTA_AUTHORIZATION_SERVER=default
# With multi-org off, an SSO sign-in in one of these domains joins `default` as a member; empty,
# SSO admits only members, invites and the first owner. Comma-separated, e.g. example.com,example.org
FACTORIAL_AUTH__ALLOWED_DOMAINS=
# The origin the browser reaches the dashboard on, with no path: settings refuse one, because
# the app adds /factorial itself (tech-stack decision 74). Also where the operator MCP server
# answers: <this>/factorial/mcp/, or http://localhost:8000/factorial/mcp/ when this is empty
# (docs/mcp.md).
FACTORIAL_AUTH__EXTERNAL_URL=
# Dashboard session lifetime, in seconds (a week).
FACTORIAL_AUTH__SESSION_MAX_AGE=604800
# Set, the first account on an empty install must send this to own it, and SSO waits for that
# account. Empty, whoever signs up first owns the install: sign up before others reach the port.
# FACTORIAL_AUTH__BOOTSTRAP_TOKEN=

# --- multi-org ------------------------------------------------------------
# Many organizations (design.md 7.19). Off in the self-hosted build: `default` is the one
# organization, and an account comes from the first signup on an empty install, an invite, or
# an SSO sign-in in ALLOWED_DOMAINS. On, anyone signs up and makes organizations, and
# ALLOWED_DOMAINS no longer limits who signs in. Accounts, members and invites exist either way;
# an install with data and no owner gets one with `python -m orchestrator.admin grant-owner`.
FACTORIAL_MULTI_ORG__ENABLED=false

# --- mail -----------------------------------------------------------------
# One SMTP server (tech-stack decision 91). Set, a password signup must verify its email before
# it reaches anything, and people can reset a forgotten password (design.md 7.19). Empty, nothing
# is sent and neither exists. With multi-org on, the API refuses to start without it.
# On AWS this is SES's SMTP endpoint (docs/aws.md). Links in the emails start with
# FACTORIAL_AUTH__EXTERNAL_URL.
# FACTORIAL_MAIL__SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# FACTORIAL_MAIL__SMTP_PORT=587
# FACTORIAL_MAIL__SMTP_USERNAME=
# FACTORIAL_MAIL__SMTP_PASSWORD=
# starttls (port 587), tls (port 465), or none for a server that takes no password. With
# SMTP_PORT unset, the port follows it.
# FACTORIAL_MAIL__SECURITY=starttls
# FACTORIAL_MAIL__FROM_ADDRESS=Factorial <no-reply@example.com>

# --- worker ---------------------------------------------------------------
FACTORIAL_WORKER__POLL_INTERVAL_SECONDS=30
# The least time between the starts of two fleet passes. Webhook wakes inside it share one pass.
# Must not exceed the poll interval; the worker refuses to start otherwise.
FACTORIAL_WORKER__MIN_PASS_GAP_SECONDS=30
# Must outlive the slowest spawn, because the tick holds an
# OPEN Postgres transaction across the entire blocking spawn
# (WorkerSettings.lease_seconds): any idle_in_transaction_session_timeout set below
# this value kills the tick mid-spawn, rolling back the RUNNING step_run row while
# the spawned agent keeps running unsupervised — the next tick then spawns a SECOND one.
# docker-compose.yml's `database`, the image's Postgres, leaves that timeout at Postgres's own
# default (disabled), so compose needs no change to satisfy this; a self-managed
# Postgres must disable it, or set it well above this value.
FACTORIAL_WORKER__LEASE_SECONDS=3600
# Identifies this loop runner in ticket.lease_owner; defaults to the hostname.
FACTORIAL_WORKER__NAME=
# Tickets leased per tick.
FACTORIAL_WORKER__BATCH_SIZE=10
# Consecutive raising ticks before a ticket stops being leased (decision 31).
# 20 is ten minutes at the poll above; raise it if a GitHub outage ever quarantines
# the fleet, since the count is per ticket and an outage hits every one at once.
FACTORIAL_WORKER__QUARANTINE_AFTER=20

# --- claude_cli adapter (tech-stack decisions 16 and 44) ------------------------
# Runs agents through the `claude` CLI in a git worktree on this host; the fleet runs
# it. It has NO containment: the agent runs with permissions bypassed on the host
# filesystem, holding a real repo-scoped GH_TOKEN — an accepted risk (decision 16).
# Required when that kind is selected — every run's worktree lives under it, and a
# resolved path that escapes it refuses to spawn. No default on purpose.
FACTORIAL_RUNTIME__CLAUDE_CLI__LOCAL_ROOT=
FACTORIAL_RUNTIME__CLAUDE_CLI__CLAUDE_BIN=claude
# Which credential pays, for a process that names no `runtime:` (a registry row
# decides per type otherwise).
#   api_key  (default) bills Anthropic API credits from ANTHROPIC_API_KEY, stored on the
#            Runtime (or as a project secret for a process that names no runtime).
#   subscription
#            bills a Claude subscription through CLAUDE_CODE_OAUTH_TOKEN, the long-lived
#            token `claude setup-token` prints once in a browser session on YOUR machine
#            (Claude Code has no device-code login to run server-side). Stored on the
#            Runtime page, read from the store only. The run launches with
#            ANTHROPIC_API_KEY removed from its environment, because a set key outranks
#            the token. Its total_cost_usd is a list-price estimate, not a bill.
FACTORIAL_RUNTIME__CLAUDE_CLI__AUTH_MODE=api_key

# --- codex_cli adapter (tech-stack decisions 34 and 44) -------------------------
# The single-container image sets this LOCAL_ROOT itself (/data/runs/codex_cli). codex_cli runs
# there when the container starts with the seccomp profile docker/seccomp.json, as
# `make up` starts it (decision 52).
# Runs agents through OpenAI's `codex` CLI, inside codex's own workspace-write sandbox;
# the fleet runs it too. Pinned against codex-cli 0.164.0.
# Required when that kind is selected, and undefaulted for the same reason as above.
FACTORIAL_RUNTIME__CODEX_CLI__LOCAL_ROOT=
FACTORIAL_RUNTIME__CODEX_CLI__CODEX_BIN=codex
# Which credential pays, and it also decides which MODELS work.
#   api_key  (default) bills OpenAI API credits, from the OPENAI_API_KEY above stored on
#            the Runtime (or as a project secret). Serves gpt-5.x-codex.
#   subscription
#            bills a Codex subscription. The login is read from the secret store as
#            `CODEX_AUTH_JSON` (the contents of an `auth.json`): the Runtime's credential, or
#            the project's for a process that names no runtime. It is the only source a
#            worker with no operator login has; on a developer machine it falls back to
#            ~/.codex/auth.json, so `codex login` is the whole setup there. No API key either
#            way. Serves gpt-5.6-terra.
# A model from the wrong mode fails as the vendor's own 404/400 on the first turn, which
# reads exactly like an adapter bug. Manifests must name the id the mode serves.
FACTORIAL_RUNTIME__CODEX_CLI__AUTH_MODE=api_key
# Where `subscription` mode reads that login. UNSET means ~/.codex/auth.json, where `codex login`
# leaves it -- left commented out on purpose, because an empty value is not unset here: it
# parses to Path(".") and would be read as the auth file (issue #162). Read, never written:
# the copy each run refreshes is its own, so a run cannot log you out.
#FACTORIAL_RUNTIME__CODEX_CLI__SUBSCRIPTION_AUTH_FILE=/Users/you/.codex/auth.json
# Codex reports tokens but no dollar figure; the worker estimates cost_usd from list
# prices and records it as `estimated` (decision 34).

# --- E2B sandboxes (tech-stack decision 25) -------------------------------------
# A runtime whose isolation is `e2b` runs claude or codex in a hosted E2B microVM per run.
# The model credential, the GitHub token and MCP headers are set by E2B's egress proxy, never
# inside the sandbox; a codex subscription login is the one exception, deleted before a pause.
# Each E2B runtime holds its own E2B team: its E2B_API_KEY credential and its template, both set
# on the Runtime page. The project must also list the runtime in settings.runtime_allowlist.
# Each run's stream mirror and state. Set, it turns E2B on; the API reads transcripts here, so
# the API and the worker must share it (the image sets /data/runs/e2b).
FACTORIAL_RUNTIME__E2B__STATE_ROOT=
# Names this deployment in each sandbox's metadata. The reaper removes only its own
# deployment's unwanted sandboxes, so a laptop and the deployment can share one team. Keep it
# when the deployment moves to a new host. Empty, the cloud sandbox is not offered.
FACTORIAL_RUNTIME__E2B__DEPLOYMENT=
# Hosts every E2B run may reach beyond GitHub, its model API and its project's egress_allowlist.
FACTORIAL_RUNTIME__E2B__EGRESS=[]
# Days a finished run's mirror is kept.
FACTORIAL_RUNTIME__E2B__RETAIN_DAYS=30
# Unset, one organization offers the API-key types (claude_api, codex_api) on the host, and in
# the cloud sandbox when the deployment name above is set. The public image fills that name in,
# once per install. To offer a subscription or Bedrock type, list it. Entries are `<type>@<local_cli|e2b>`, comma separated. An `@e2b` entry needs the
# deployment name: without it the start stops.
# An empty value is the same as unset. An unknown entry stops the start. Every entry:
#   claude_api@local_cli            Claude Code · API key       · On the host
#   claude_api@e2b                  Claude Code · API key       · Managed cloud sandbox
#   claude_subscription@local_cli   Claude Code · Subscription  · On the host
#   claude_subscription@e2b         Claude Code · Subscription  · Managed cloud sandbox
#   codex_api@local_cli             Codex · API key             · On the host
#   codex_api@e2b                   Codex · API key             · Managed cloud sandbox
#   codex_subscription@local_cli    Codex · Subscription        · On the host
#   codex_subscription@e2b          Codex · Subscription        · Managed cloud sandbox
#   codex_bedrock@local_cli         Codex · AWS Bedrock         · On the host (no e2b entry)
#FACTORIAL_RUNTIME__OFFERED=claude_api@local_cli,claude_subscription@local_cli,codex_api@local_cli,codex_subscription@local_cli,codex_bedrock@local_cli

# The sign-ins a person may switch the assistant to on its settings page. Unset, the two API
# keys. Entries are `<backend>:<auth_mode>`, comma separated. An empty value is the same as unset,
# and an unknown entry stops the start. An organization keeps a sign-in it already saved, even
# when the list leaves it out. Multi-org never offers codex_cli:bedrock. Every entry:
#   claude_sdk:api_key        Claude · API key
#   claude_sdk:subscription   Claude · Subscription
#   codex_cli:api_key         Codex · API key
#   codex_cli:subscription    Codex · Subscription
#   codex_cli:bedrock         Codex · AWS Bedrock, on the host's role
#FACTORIAL_ASSISTANT__OFFERED=claude_sdk:api_key,claude_sdk:subscription,codex_cli:api_key,codex_cli:subscription,codex_cli:bedrock

# --- E2B sandbox templates (tech-stack decision 25) -----------------------------
# A template is private to the E2B team that built it, so each team builds its own:
# `E2B_API_KEY=<team key> make e2b-template` builds claude-<version> and
# codex-<version> from these, each on its CLI's latest version, and smokes each build
# with ANTHROPIC_API_KEY / OPENAI_API_KEY from the environment. Every runtime holding that
# team's key then lists the builds to choose from. CLAUDE_CLI_VERSION / CODEX_CLI_VERSION in
# the environment build a known version instead, never one below `MIN_VERSIONS` in
# runtime/adapters/e2b/template.py. Every build ignores E2B's layer cache. Delete a retired
# template in E2B only after every runtime is repointed.
FACTORIAL_RUNTIME__E2B__TEMPLATE_CPU_COUNT=2
FACTORIAL_RUNTIME__E2B__TEMPLATE_MEMORY_MB=4096
# Read by scripts/smoke/claude-e2b-smoke.py and scripts/smoke/codex-e2b-smoke.py only, never by
# the orchestrator: the team and the claude or codex build each runs in.
#E2B_API_KEY=
#E2B_CLAUDE_TEMPLATE=
#E2B_CODEX_TEMPLATE=

# --- sessions (tech-stack decisions 54 and 56) ----------------------------------
# Off, no browser can attach to, type into or reopen a session (decision 57). Runs are sessions
# either way, and a parked run still resumes when its label is removed. Durations take seconds
# or ISO 8601 (PT10M).
FACTORIAL_TERMINAL__ENABLED=false
# How long an idle session waits at its prompt before it parks for a human.
FACTORIAL_TERMINAL__IDLE_PARK_AFTER=600
# How long after the last typed input a session whose postconditions hold is finished.
FACTORIAL_TERMINAL__FINISH_GRACE=60
# How long a session lives from its spawn or a dashboard Resume before it parks for a human,
# whatever its agent reports.
FACTORIAL_TERMINAL__SESSION_CEILING=14400
# How often a parked session's postconditions are read again. Met, a session the loop parked
# at its prompt is accepted without a resume (decision 56).
FACTORIAL_TERMINAL__PARKED_RECHECK=300
# Turns on codex's under-development question box (decision 56).
FACTORIAL_TERMINAL__CODEX_ASK_TOOL=true
# Where the terminal gateway listens (decision 57). On ECS the ALB forwards /factorial/terminal/*
# on the dashboard's origin to it; on a laptop the UI reaches this port cross-origin. The image
# binds 0.0.0.0 inside its own network.
FACTORIAL_TERMINAL__BIND=127.0.0.1
FACTORIAL_TERMINAL__PORT=8001
# The origin the dashboard dials the gateway on, which the API tells it at run time. Unset: with
# no FACTORIAL_AUTH__EXTERNAL_URL, or one on localhost, http://localhost:<port>, as `make dev`
# and `make up` publish it; with any other external URL, the API's own origin, where a proxy
# must send /factorial/terminal/* to the port, as the ECS load balancer does. An empty value is
# always the API's own origin. Commented out on purpose: empty is not unset.
#FACTORIAL_TERMINAL__PUBLIC_URL=
# Kept workspaces (decision 54): how long a finished run's workspace is kept on a ticket that
# has not exited.
FACTORIAL_WORKSPACE__RETENTION=P7D

# --- logging --------------------------------------------------------------
# NOT pydantic Settings fields: every service reads both with os.getenv in
# orchestrator/logs.py's configure_logging() (tech-stack decision 81), so this
# file cannot set them, and the lines below show the defaults only. Export them
# in the shell, or put them in the task's environment, where the image's init
# leaves them. The level is uppercased on read; an unknown level or format
# stops the service at start.
# FACTORIAL_LOG_LEVEL=INFO
# json (one object per line, with the bound ticket and run ids) or text. make
# dev and its parts default to text.
# FACTORIAL_LOG_FORMAT=json
